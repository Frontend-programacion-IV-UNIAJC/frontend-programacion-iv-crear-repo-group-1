
---
const { libro } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article
  class="libro"
  data-titulo={libro.titulo}
  data-autor={libro.autor}
  data-categoria={libro.categoria}
  data-anio={libro.anio}
>
  <img
    src={libro.imagen}
    alt={`Portada de ${libro.titulo}`}
    loading="lazy"
  />

  <div class="libro__contenido">
    <span class="categoria">{libro.categoria}</span>

    <h2>{libro.titulo}</h2>

    <p class="autor">{libro.autor}</p>

    <p class="anio">Año: {libro.anio}</p>

    <a href={`${base}detalle/?id=${libro.id}`} class="boton">
      Ver detalles
    </a>
  </div>
</article>

<style>
  .libro {
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .libro img {
    width: 100%;
    height: 260px;
    object-fit: contain;
    background: #f3f3f3;
  }

  .libro__contenido {
    padding: 20px;
  }

  .categoria {
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .libro h2 {
    margin-top: 8px;
    font-size: 1.15rem;
  }

  .autor,
  .anio {
    margin-top: 8px;
    font-size: 0.9rem;
  }

  .boton {
    display: inline-block;
    margin-top: 16px;
    padding: 10px 16px;
    color: white;
    background: var(--color-primary);
    border-radius: var(--border-radius-md);
  }

  .boton:hover {
    background: var(--color-primary-dark);
  }
</style>
