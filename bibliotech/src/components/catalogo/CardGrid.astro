
---
import Card from "./Card.astro";

type Libro = {
  id: string | number;
  titulo: string;
  autor: string;
  categoria: string;
  imagen: string;
  anio: number;
  editorial: string;
  descripcion: string;
};

interface Props {
  libros: Libro[];
}

const { libros = [] } = Astro.props as Props;
---

<div class="tarjetas">
  {libros.map((libro) => (
    <Card libro={libro} />
  ))}
</div>

<style>
  .tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
    width: 100%;
    align-items: stretch;
  }

  @media (max-width: 480px) {
    .tarjetas {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
