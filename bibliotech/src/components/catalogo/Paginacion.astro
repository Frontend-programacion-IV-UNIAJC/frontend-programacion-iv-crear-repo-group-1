
---
interface Props {
  paginaActual?: number;
  totalPaginas?: number;
}

const {
  paginaActual = 1,
  totalPaginas = 1
}: Props = Astro.props;

const paginaAnterior = Math.max(1, paginaActual - 1);
const paginaSiguiente = Math.min(totalPaginas, paginaActual + 1);

const parametros = Astro.url.searchParams;
---

<nav class="paginacion" aria-label="Paginación del catálogo">
  <a
    class:list={[
      "paginacion__boton",
      { "paginacion__boton--desactivado": paginaActual <= 1 }
    ]}
    href={`?${new URLSearchParams({
      ...Object.fromEntries(parametros),
      pagina: String(paginaAnterior)
    })}`}
    aria-disabled={paginaActual <= 1}
  >
    Anterior
  </a>

  <span class="paginacion__info">
    Página {paginaActual} de {totalPaginas}
  </span>

  <a
    class:list={[
      "paginacion__boton",
      { "paginacion__boton--desactivado": paginaActual >= totalPaginas }
    ]}
    href={`?${new URLSearchParams({
      ...Object.fromEntries(parametros),
      pagina: String(paginaSiguiente)
    })}`}
    aria-disabled={paginaActual >= totalPaginas}
  >
    Siguiente
  </a>
</nav>

<style>
  .paginacion {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin: 32px 0;
  }

  .paginacion__boton {
    padding: 10px 18px;
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
  }

  .paginacion__boton:hover {
    background: var(--color-primary);
    color: white;
  }

  .paginacion__boton--desactivado {
    opacity: 0.4;
    pointer-events: none;
  }

  .paginacion__info {
    color: var(--color-text-secondary);
    font-weight: 600;
  }
</style>
