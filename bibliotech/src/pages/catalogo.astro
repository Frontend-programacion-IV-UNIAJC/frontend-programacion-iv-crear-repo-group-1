
---
import Layout from "../layouts/Layout.astro";
import { obtenerLibros } from "../services/api.js";
import CardGrid from "../components/catalogo/CardGrid.astro";
import Filtros from "../components/catalogo/Filtros.astro";
import BarraDeBusqueda from "../components/catalogo/BarraDeBusqueda.astro";

interface Libro {
  id: string | number;
  titulo: string;
  autor: string;
  categoria: string;
  imagen: string;
  anio: number;
  editorial: string;
  descripcion: string;
}

const libros: Libro[] = await obtenerLibros();

const categorias: string[] = Array.from(
  new Set(libros.map((libro: Libro) => libro.categoria))
);
---

<Layout
  titulo="Catálogo | BiblioTech"
  descripcion="Explora nuestro catálogo de libros"
  activo="catalogo"
>
  <section class="contenedor catalogo">
    <div class="encabezado">
      <h1>Catálogo de libros</h1>
      <p>Explora y encuentra libros de tu interés.</p>
    </div>

    <BarraDeBusqueda />
    <Filtros categorias={categorias} />

    <p id="contador" class="contador">
      {libros.length} libros encontrados
    </p>

    <div id="resultados">
      <CardGrid libros={libros} />
    </div>

    <p id="sin-resultados" class="sin-resultados" hidden>
      No se encontraron libros con los filtros seleccionados.
    </p>
  </section>
</Layout>

<script>
  const formulario = document.querySelector<HTMLFormElement>(".busqueda");
  const busqueda = document.querySelector<HTMLInputElement>("#buscar-libro");

  const opcionesCategoria =
    document.querySelectorAll<HTMLAnchorElement>(".filtros__opcion");

  const contador = document.querySelector<HTMLElement>("#contador");
  const mensaje = document.querySelector<HTMLElement>("#sin-resultados");

  let categoriaSeleccionada = "Todas";

  function filtrarLibros() {
    const texto = busqueda?.value.toLowerCase().trim() || "";
    const tarjetas = document.querySelectorAll<HTMLElement>(".libro");

    let cantidad = 0;

    tarjetas.forEach((tarjeta) => {
      const titulo = tarjeta.dataset.titulo?.toLowerCase() || "";
      const autor = tarjeta.dataset.autor?.toLowerCase() || "";
      const categoria = tarjeta.dataset.categoria || "";

      const coincideTexto =
        titulo.includes(texto) || autor.includes(texto);

      const coincideCategoria =
        categoriaSeleccionada === "Todas" ||
        categoria === categoriaSeleccionada;

      const mostrar = coincideTexto && coincideCategoria;

      tarjeta.hidden = !mostrar;

      if (mostrar) {
        cantidad++;
      }
    });

    if (contador) {
      contador.textContent = `${cantidad} libros encontrados`;
    }

    if (mensaje) {
      mensaje.hidden = cantidad > 0;
    }
  }

  opcionesCategoria.forEach((opcion) => {
    opcion.addEventListener("click", (evento) => {
      evento.preventDefault();

      categoriaSeleccionada = opcion.dataset.categoria || "Todas";

      opcionesCategoria.forEach((elemento) => {
        elemento.classList.remove("filtros__opcion--activa");
      });

      opcion.classList.add("filtros__opcion--activa");

      filtrarLibros();
    });
  });

  busqueda?.addEventListener("input", filtrarLibros);

  formulario?.addEventListener("submit", (evento) => {
    evento.preventDefault();
    filtrarLibros();
  });

  filtrarLibros();
</script>

<style>
  .catalogo {
    padding-top: 48px;
    padding-bottom: 64px;
  }

  .encabezado {
    margin-bottom: 32px;
  }

  .encabezado h1 {
    font-size: 2rem;
    margin-bottom: 8px;
  }

  .contador {
    margin: 24px 0;
    font-weight: 600;
  }

  .sin-resultados {
    padding: 32px;
    text-align: center;
  }

  @media (max-width: 600px) {
    .catalogo {
      padding-top: 32px;
    }

    .encabezado h1 {
      font-size: 1.6rem;
    }
  }
</style>
