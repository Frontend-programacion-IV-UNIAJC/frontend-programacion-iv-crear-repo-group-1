
---
import Layout from "../layouts/Layout.astro";
import Boton from "../components/ui/Boton.astro";

const base = import.meta.env.BASE_URL;
---

<Layout
  titulo="BiblioTech | Descubre tu próximo libro"
  descripcion="Explora libros, consulta información bibliográfica y descubre nuevas lecturas con BiblioTech."
  activo="inicio"
>
  <section class="portada">
    <div class="contenedor portada__interior">
      <div class="portada__texto">
        <p class="rotulo">Explora. Descubre. Lee.</p>

        <h1>Encuentra tu próximo libro en BiblioTech</h1>

        <p class="portada__entrada">
          Un espacio para buscar libros, conocer sus autores y explorar
          información bibliográfica de manera sencilla y organizada.
        </p>

        <div class="portada__acciones">
          <Boton href={`${base}catalogo`} tamano="grande">
            Explorar catálogo
          </Boton>

          <Boton href={`${base}registro`} variante="secundario" tamano="grande">
            Crear cuenta
          </Boton>
        </div>
      </div>

      <div class="portada__imagen" aria-label="Presentación de BiblioTech">
        <div class="libro libro--uno">
          <span>BIBLIOTECH</span>
          <strong>El mundo de los libros</strong>
        </div>
        <div class="libro libro--dos">
          <span>LECTURA</span>
          <strong>Descubre nuevas historias</strong>
        </div>
        <div class="libro libro--tres">
          <span>CONOCIMIENTO</span>
          <strong>Aprende cada día</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="contenedor seccion">
    <div class="seccion__encabezado">
      <div>
        <p class="rotulo">Nuestra biblioteca</p>
        <h2>Explora nuestro catálogo</h2>
      </div>

      <Boton href={`${base}catalogo`} variante="fantasma">
        Ver catálogo
      </Boton>
    </div>

    <div class="pendiente">
      <h3>Próximamente encontrarás aquí tus libros</h3>
      <p>
        En esta sección se mostrarán los libros destacados del catálogo.
      </p>
      <p>Las tarjetas se incorporarán en la clase 5.</p>
    </div>
  </section>

  <section class="contenedor seccion">
    <p class="rotulo">Conoce BiblioTech</p>
    <h2>Todo lo que necesitas para explorar libros</h2>

    <div class="caracteristicas">
      <article class="caracteristica">
        <span class="caracteristica__numero">01</span>
        <h3>Busca libros</h3>
        <p>
          Encuentra publicaciones mediante su título, autor o información
          bibliográfica.
        </p>
      </article>

      <article class="caracteristica">
        <span class="caracteristica__numero">02</span>
        <h3>Explora categorías</h3>
        <p>
          Organiza tu búsqueda por materias y épocas para encontrar lecturas
          de tu interés.
        </p>
      </article>

      <article class="caracteristica">
        <span class="caracteristica__numero">03</span>
        <h3>Consulta detalles</h3>
        <p>
          Conoce información como el título, autor, año de publicación y
          materias de cada libro.
        </p>
      </article>
    </div>
  </section>
</Layout>

<style>
  .portada {
    background: linear-gradient(
      135deg,
      var(--color-surface-secondary),
      var(--color-background)
    );
    border-bottom: 1px solid var(--border-color);
  }

  .portada__interior {
    display: grid;
    align-items: center;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 56px;
  }

  .rotulo {
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }

  .portada__texto h1 {
    max-width: 600px;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    margin-bottom: 20px;
  }

  .portada__entrada {
    max-width: 500px;
    font-size: var(--text-lg);
    margin-bottom: 28px;
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .portada__imagen {
    min-height: 300px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 20px;
  }

  .libro {
    width: 30%;
    min-height: 210px;
    padding: 18px 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: white;
    border-radius: 5px 12px 12px 5px;
    box-shadow: var(--shadow-md);
  }

  .libro span {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
  }

  .libro strong {
    font-size: 1rem;
    line-height: 1.3;
  }

  .libro--uno {
    background: var(--color-primary);
    transform: rotate(-8deg);
  }

  .libro--dos {
    background: #8b7cf6;
    transform: translateY(-15px);
  }

  .libro--tres {
    background: #e49a59;
    transform: rotate(8deg);
  }

  .seccion {
    padding-top: 56px;
  }

  .seccion__encabezado {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 24px;
  }

  .seccion__encabezado h2,
  .seccion > h2 {
    margin-bottom: 20px;
  }

  .pendiente {
    padding: 36px 20px;
    border: 2px dashed var(--border-color);
    border-radius: var(--border-radius-lg);
    text-align: center;
  }

  .pendiente h3 {
    margin-bottom: 10px;
  }

  .pendiente p {
    font-size: var(--text-sm);
  }

  .caracteristicas {
    display: grid;
    gap: 20px;
    padding-bottom: 40px;
  }

  .caracteristica {
    padding: 24px;
    background: var(--color-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--border-radius-lg);
  }

  .caracteristica__numero {
    display: inline-block;
    color: var(--color-primary);
    font-weight: 700;
    margin-bottom: 14px;
  }

  .caracteristica h3 {
    margin-bottom: 10px;
  }

  .caracteristica p {
    font-size: var(--text-sm);
  }

  @media (min-width: 768px) {
    .caracteristicas {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 900px) {
    .portada__interior {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }
</style>
